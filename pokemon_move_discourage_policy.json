{
  "version": "2026-04-17",
  "title": "Pokemon move discourage policy by role",
  "notes": [
    "These are discourage lists, not ban lists.",
    "Moves in allow_lists should never be auto-flagged as bad just because they are low power or conditional.",
    "Conditional groups require role, set, or board-state checks before discouraging.",
    "Designed for support and attacker role classification."
  ],
  "global_logic": {
    "policy_type": "discourage_not_ban",
    "steps": [
      "Classify Pokemon role as support or attacker.",
      "Apply the matching discourage list.",
      "Override discouragement if the move is explicitly part of the approved set, team mode, or active board-state synergy.",
      "Never auto-discourage moves in the allow_lists."
    ],
    "override_conditions": [
      "move is explicitly present in the approved set for that Pokemon",
      "team mode explicitly enables the move or archetype",
      "active board-state makes the move high-value right now",
      "no stronger legal alternative exists for the intended role"
    ]
  },
  "roles": {
    "support": {
      "hard_discourage": [
        "Hyper Beam",
        "Giga Impact",
        "Blast Burn",
        "Hydro Cannon",
        "Frenzy Plant",
